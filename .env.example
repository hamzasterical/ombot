# Copy to .env for local runs. On Alternate Clouds, set these in the service's Variables tab.
# Never commit real values.

# --- LLM (OpenRouter, OpenAI-compatible): one URL and one key for every model ----------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Optional backup keys from other accounts, comma-separated. When the active key is rate-limited, the same request
# is retried on the next key (same URL and models); a key is skipped until its rate-limit window resets.
LLM_BACKUP_API_KEYS=
# Cheap model: classifier, report/summary, low-tier reply
CLASSIFIER_MODEL=
REPORT_MODEL=
LOW_TIER_REPLY_MODEL=
# Strong model: delegated moderate-tier agent (tool calling)
AGENT_MODEL=
# Optional OpenRouter attribution
LLM_SITE_URL=
# Parallel LLM calls during eval (free tiers rate-limit hard)
LLM_MAX_CONCURRENCY=2

# --- fastn (Slack / ClickUp / Gmail delivery) -------------------------------------------
# false = deliveries are logged locally only (safe offline demo mode)
FASTN_ENABLED=false
FASTN_GATEWAY_URL=https://api.fastn.dev/api/v1/workflows
FASTN_API_KEY=
FASTN_AUTH_METHOD=bearer
# test = run each workflow's latest published version
FASTN_ENV=test
FASTN_TIMEOUT_SECONDS=30
# JSON map of workflow name -> fastn workflow id, e.g. {"create_ticket":"wf_..."} (see fastn/workflows.json)
FASTN_WORKFLOW_IDS={}
# Must equal the OMBOT_REPLY_AUTH_SECRET secret in fastn (signs approved customer replies)
REPLY_AUTH_SECRET=
# Optional: shown in Slack alerts / linked from ClickUp tickets (public URL of this app)
OFFICER_EMAIL=
DASHBOARD_URL=

# --- Email intake ---------------------------------------------------------------------
# Customer emails to the bank's Gmail inbox become complaints; replies go back to the sender in-thread.
# Polls the fastn fetch_inbound_emails workflow (add its id to FASTN_WORKFLOW_IDS). Needs FASTN_ENABLED=true,
# and the fastn env config ombotReplyAllowRealRecipients=true for replies to reach the sender.
INBOUND_EMAIL_ENABLED=false
BANK_INBOX_EMAIL=
INBOUND_POLL_SECONDS=60
# Only mail received after this ISO time is ingested (empty = from the first poll onwards)
INBOUND_EMAIL_SINCE=

# --- App ------------------------------------------------------------------------------
# The Docker image sets DATABASE_URL=sqlite:////app/data/app.db
DATABASE_URL=sqlite:///./app.db
# Load the demo dataset into an empty database at startup
SEED_ON_STARTUP=true
AGENT_MAX_STEPS=8
# Per model turn of the delegated agent (not the whole run)
AGENT_TIMEOUT_SECONDS=60
# Supervised runs: how long the agent waits for the reviewer on one step before the case goes back to a human
AGENT_REVIEW_TIMEOUT_SECONDS=1800
# Circuit breaker: after this many rate-limit failures in a row, skip LLM calls for the cooldown
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=120
CONFIDENCE_THRESHOLD=0.7
# Port the server listens on (the Docker image defaults to 8000; must match the platform's PORT)
PORT=8000

# Session cookie signing key (long random string) and HTTPS-only cookie
AUTH_SECRET=
AUTH_COOKIE_SECURE=true
